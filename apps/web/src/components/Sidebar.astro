---
interface Props {
  tenantName: string;
  logoUrl: string | null;
  roles: string[];
  currentPath: string;
}

const { tenantName, logoUrl, roles, currentPath } = Astro.props;

const isApprover = roles.some((r) => ['MANAGER', 'HR', 'APPROVER', 'TENANT_ADMIN'].includes(r));

const links = [
  { href: '/', label: 'Inicio', icon: 'home' },
  { href: '/attendance', label: 'Marcación', icon: 'clock' },
  { href: '/payroll', label: 'Rol de pagos', icon: 'cash' },
  { href: '/requests', label: 'Solicitudes', icon: 'inbox' },
  { href: '/documents', label: 'Documentos', icon: 'folder' },
  { href: '/notifications', label: 'Notificaciones', icon: 'bell' },
];

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}

const ICONS: Record<string, string> = {
  home: 'M3 11.5 12 4l9 7.5M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9',
  clock: 'M12 7v5l3.5 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  cash: 'M3 7h18v10H3V7Zm9 2.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM6 7v10M18 7v10',
  inbox: 'M3 12h4l2 3h6l2-3h4M5 5h14l2 7v7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-7l2-7Z',
  folder: 'M3 7a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7Z',
  bell: 'M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM9.5 20a2.5 2.5 0 0 0 5 0',
  check: 'm5 12 5 5 9-9',
};
---

<aside class="sidebar">
  <div class="sidebar-brand">
    {logoUrl ? <img src={logoUrl} alt={tenantName} class="sidebar-logo" /> : <div class="sidebar-logo sidebar-logo-fallback">{tenantName.slice(0, 1)}</div>}
    <span>{tenantName}</span>
  </div>
  <nav>
    {links.map((link) => (
      <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={`<path d="${ICONS[link.icon]}" />`} />
        {link.label}
      </a>
    ))}
    {isApprover && (
      <a href="/requests/pending" aria-current={isActive('/requests/pending') ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={`<path d="${ICONS.check}" />`} />
        Aprobaciones
      </a>
    )}
  </nav>
  <form method="POST" action="/logout">
    <button type="submit" class="logout-btn">Cerrar sesión</button>
  </form>
</aside>
