---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiFetch } from '../../lib/api';

const { tenant, accessToken } = Astro.locals;

interface Payslip {
  id: string;
  periodMonth: number;
  periodYear: number;
  netSalary: string;
  currency: string;
}

const MONTHS = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
];

const payslips = await apiFetch<Payslip[]>('/payroll/me', {
  tenantSlug: tenant.slug,
  accessToken,
}).catch(() => []);
---

<BaseLayout title="Rol de pagos">
  <h1>Rol de pagos</h1>
  <p class="muted">Información de solo lectura, sincronizada automáticamente desde el ERP.</p>
  <div class="card">
    {payslips.length === 0 && <p class="empty-state">Todavía no hay recibos sincronizados.</p>}
    {payslips.length > 0 && (
      <div class="table-wrap">
        <table>
          <thead><tr><th>Periodo</th><th>Neto</th><th>Recibo</th></tr></thead>
          <tbody>
            {payslips.map((p) => (
              <tr>
                <td data-label="Periodo">{MONTHS[p.periodMonth - 1] ?? p.periodMonth} {p.periodYear}</td>
                <td data-label="Neto"><strong>{p.netSalary} {p.currency}</strong></td>
                <td data-label="Recibo">
                  <a class="btn-secondary" href={`/api/payroll/me/${p.id}/pdf`} target="_blank">Descargar PDF</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>
