---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiFetch } from '../../lib/api';

const { tenant, accessToken } = Astro.locals;
const folderId = Astro.url.searchParams.get('folderId');

interface Doc {
  id: string;
  title: string;
  mimeType: string;
}

const documents = await apiFetch<Doc[]>(
  `/documents${folderId ? `?folderId=${folderId}` : '?folderId='}`,
  { tenantSlug: tenant.slug, accessToken },
).catch(() => []);
---

<BaseLayout title="Documentos">
  <h1>Documentos</h1>
  <div class="card">
    {documents.length === 0 && <p class="empty-state">No tienes documentos visibles en esta carpeta.</p>}
    {documents.length > 0 && (
      <div class="table-wrap">
        <table>
          <thead><tr><th>Título</th><th>Tipo</th><th></th></tr></thead>
          <tbody>
            {documents.map((doc) => (
              <tr>
                <td data-label="Título">{doc.title}</td>
                <td data-label="Tipo"><span class="badge badge-neutral">{doc.mimeType}</span></td>
                <td data-label="Acción">
                  <a class="btn-secondary" href={`/api/documents/${doc.id}/download`} target="_blank">Ver</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>
