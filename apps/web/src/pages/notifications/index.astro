---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiFetch } from '../../lib/api';

const { tenant, accessToken } = Astro.locals;

interface Notification {
  id: string;
  title: string;
  body: string;
  scope: string;
  createdAt: string;
  reads: { readAt: string }[];
}

const notifications = await apiFetch<Notification[]>('/notifications/me', {
  tenantSlug: tenant.slug,
  accessToken,
}).catch(() => []);
---

<BaseLayout title="Notificaciones">
  <h1>Notificaciones</h1>
  {notifications.map((n) => (
    <div class="card" style={n.reads.length ? 'opacity:0.6' : ''}>
      <strong>{n.title}</strong> <span>({n.scope})</span>
      <p>{n.body}</p>
      <small>{new Date(n.createdAt).toLocaleString()}</small>
    </div>
  ))}
  {notifications.length === 0 && <p>No tienes notificaciones.</p>}
</BaseLayout>
