---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiFetch } from '../../lib/api';

const { tenant, accessToken } = Astro.locals;

interface Notification {
  id: string;
  title: string;
  body: string;
  scope: string;
  createdAt: string;
  reads: { readAt: string }[];
}

const SCOPE_LABELS: Record<string, string> = {
  COMPANY: 'Toda la empresa',
  DEPARTMENT: 'Departamento',
  CITY: 'Ciudad',
  INDIVIDUAL: 'Para ti',
};

const notifications = await apiFetch<Notification[]>('/notifications/me', {
  tenantSlug: tenant.slug,
  accessToken,
}).catch(() => []);
---

<BaseLayout title="Notificaciones">
  <h1>Notificaciones</h1>
  <div class="stack">
    {notifications.map((n) => {
      const unread = n.reads.length === 0;
      return (
        <div class={`card notification-card ${unread ? 'notification-unread' : ''}`}>
          <div class="row" style="justify-content:space-between; align-items:flex-start;">
            <strong>{n.title}</strong>
            <span class="badge badge-info">{SCOPE_LABELS[n.scope] ?? n.scope}</span>
          </div>
          <p style="margin:0.5rem 0;">{n.body}</p>
          <small class="muted">{new Date(n.createdAt).toLocaleString()}</small>
        </div>
      );
    })}
  </div>
  {notifications.length === 0 && <p class="empty-state">No tienes notificaciones.</p>}
</BaseLayout>

<style>
  .notification-unread { border-left: 4px solid var(--color-accent); }
</style>
