---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiFetch } from '../../lib/api';

const { tenant, accessToken } = Astro.locals;

interface TimeEntry {
  id: string;
  type: string;
  timestamp: string;
  isLocationValid: boolean;
  distanceMeters: number | null;
}

const TYPE_LABELS: Record<string, string> = {
  CHECK_IN: 'Entrada',
  BREAK_START: 'Inicio receso',
  BREAK_END: 'Fin receso',
  CHECK_OUT: 'Salida',
};

const history = await apiFetch<TimeEntry[]>('/attendance/me', {
  tenantSlug: tenant.slug,
  accessToken,
}).catch(() => []);
---

<BaseLayout title="Marcación">
  <h1>Marcación de asistencia</h1>
  <div class="card">
    <p class="muted">La marcación requiere permiso de geolocalización del navegador: se rechaza si estás fuera del radio permitido de tu oficina.</p>
    <div class="clock-actions">
      <button class="btn-primary" data-type="CHECK_IN">Entrada</button>
      <button class="btn-secondary" data-type="BREAK_START">Inicio receso</button>
      <button class="btn-secondary" data-type="BREAK_END">Fin receso</button>
      <button class="btn-danger" data-type="CHECK_OUT">Salida</button>
    </div>
    <p id="clock-feedback" class="muted"></p>
  </div>

  <div class="card">
    <h2>Historial reciente</h2>
    {history.length === 0 && <p class="empty-state">Aún no tienes marcaciones registradas.</p>}
    {history.length > 0 && (
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tipo</th><th>Fecha/Hora</th><th>Ubicación</th></tr></thead>
          <tbody>
            {history.map((entry) => (
              <tr>
                <td data-label="Tipo">{TYPE_LABELS[entry.type] ?? entry.type}</td>
                <td data-label="Fecha/Hora">{new Date(entry.timestamp).toLocaleString()}</td>
                <td data-label="Ubicación">
                  <span class={`badge ${entry.isLocationValid ? 'badge-approved' : 'badge-rejected'}`}>
                    {entry.isLocationValid ? 'Válida' : 'Fuera de rango'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>

<script define:vars={{ tenantSlug: tenant.slug }}>
  const feedback = document.getElementById('clock-feedback');

  function getPosition() {
    return new Promise((resolve, reject) => {
      if (!navigator.geolocation) {
        reject(new Error('Este navegador no soporta geolocalización'));
        return;
      }
      navigator.geolocation.getCurrentPosition(resolve, reject, {
        enableHighAccuracy: true,
        timeout: 10_000,
      });
    });
  }

  document.querySelectorAll('[data-type]').forEach((button) => {
    button.addEventListener('click', async () => {
      feedback.textContent = 'Obteniendo ubicación...';
      try {
        const position = await getPosition();
        const res = await fetch('/api/attendance/clock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: button.dataset.type,
            latitude: position.coords.latitude,
            longitude: position.coords.longitude,
            accuracyMeters: position.coords.accuracy,
            deviceInfo: navigator.userAgent,
          }),
        });
        const data = await res.json();
        feedback.textContent = res.ok
          ? 'Marcación registrada correctamente.'
          : `No se pudo marcar: ${data.message}`;
        if (res.ok) setTimeout(() => window.location.reload(), 1200);
      } catch (err) {
        feedback.textContent = `Error obteniendo ubicación: ${err.message}`;
      }
    });
  });
</script>

<style>
  .clock-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 1rem 0; }
  .clock-actions button { flex: 1 1 140px; }
</style>
