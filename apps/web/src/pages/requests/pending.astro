---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiFetch } from '../../lib/api';

const { tenant, accessToken } = Astro.locals;

interface PendingStep {
  id: string;
  requiredRole: string;
  request: {
    id: string;
    type: string;
    employee: { firstName: string; lastName: string };
  };
}

const TYPE_LABELS: Record<string, string> = {
  VACATION: 'Vacaciones',
  PERMISSION: 'Permiso',
  LOAN: 'Préstamo',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const requestId = String(form.get('requestId'));
  const decision = String(form.get('decision'));
  await apiFetch(`/requests/${requestId}/decision`, {
    method: 'PATCH',
    tenantSlug: tenant.slug,
    accessToken,
    body: JSON.stringify({ decision }),
  }).catch(() => null);
  return Astro.redirect('/requests/pending');
}

const pending = await apiFetch<PendingStep[]>('/requests/pending-approval', {
  tenantSlug: tenant.slug,
  accessToken,
}).catch(() => []);
---

<BaseLayout title="Aprobaciones pendientes">
  <h1>Aprobaciones pendientes</h1>
  <div class="card">
    {pending.length === 0 && <p class="empty-state">No tienes solicitudes pendientes de aprobar. 🎉</p>}
    {pending.length > 0 && (
      <div class="table-wrap">
        <table>
          <thead><tr><th>Empleado</th><th>Tipo</th><th>Acción</th></tr></thead>
          <tbody>
            {pending.map((step) => (
              <tr>
                <td data-label="Empleado">{step.request.employee.firstName} {step.request.employee.lastName}</td>
                <td data-label="Tipo"><span class="badge badge-info">{TYPE_LABELS[step.request.type] ?? step.request.type}</span></td>
                <td data-label="Acción">
                  <div class="row">
                    <form method="POST">
                      <input type="hidden" name="requestId" value={step.request.id} />
                      <input type="hidden" name="decision" value="APPROVED" />
                      <button class="btn-primary" type="submit">Aprobar</button>
                    </form>
                    <form method="POST">
                      <input type="hidden" name="requestId" value={step.request.id} />
                      <input type="hidden" name="decision" value="REJECTED" />
                      <button class="btn-danger" type="submit">Rechazar</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  td form { display: inline-flex; max-width: none; }
  td .row { justify-content: flex-end; }
</style>
