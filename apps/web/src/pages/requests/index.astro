---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apiFetch } from '../../lib/api';

const { tenant, accessToken } = Astro.locals;

interface RequestItem {
  id: string;
  type: 'LOAN' | 'PERMISSION' | 'VACATION';
  status: string;
  currentStep: number;
  createdAt: string;
}

const TYPE_LABELS: Record<string, string> = {
  VACATION: 'Vacaciones',
  PERMISSION: 'Permiso',
  LOAN: 'Préstamo',
};

const STATUS_BADGE: Record<string, string> = {
  PENDING: 'badge-pending',
  APPROVED: 'badge-approved',
  REJECTED: 'badge-rejected',
  CANCELLED: 'badge-neutral',
};

const STATUS_LABELS: Record<string, string> = {
  PENDING: 'Pendiente',
  APPROVED: 'Aprobada',
  REJECTED: 'Rechazada',
  CANCELLED: 'Cancelada',
};

let formError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const type = String(form.get('type'));
  const payload: Record<string, unknown> = { type, reason: form.get('reason') };
  if (type === 'LOAN') {
    payload.amount = Number(form.get('amount'));
    payload.installments = Number(form.get('installments'));
  } else {
    payload.startDate = form.get('startDate');
    payload.endDate = form.get('endDate');
  }

  try {
    await apiFetch('/requests', {
      method: 'POST',
      tenantSlug: tenant.slug,
      accessToken,
      body: JSON.stringify(payload),
    });
    return Astro.redirect('/requests');
  } catch (e) {
    formError = e instanceof Error ? e.message : 'No se pudo crear la solicitud';
  }
}

const myRequests = await apiFetch<RequestItem[]>('/requests/me', {
  tenantSlug: tenant.slug,
  accessToken,
}).catch(() => []);
---

<BaseLayout title="Mis solicitudes">
  <h1>Solicitudes</h1>

  <div class="card">
    <h2>Nueva solicitud</h2>
    {formError && <p class="error">{formError}</p>}
    <form method="POST" class="form-grid">
      <select name="type" required>
        <option value="VACATION">Vacaciones</option>
        <option value="PERMISSION">Permiso</option>
        <option value="LOAN">Préstamo</option>
      </select>
      <div></div>
      <input type="date" name="startDate" placeholder="Desde" />
      <input type="date" name="endDate" placeholder="Hasta" />
      <input type="number" name="amount" placeholder="Monto (préstamo)" step="0.01" />
      <input type="number" name="installments" placeholder="Cuotas (préstamo)" />
      <textarea name="reason" placeholder="Motivo"></textarea>
      <button class="btn-primary" type="submit">Enviar solicitud</button>
    </form>
  </div>

  <div class="card">
    <h2>Mis solicitudes</h2>
    {myRequests.length === 0 && <p class="empty-state">Todavía no has creado ninguna solicitud.</p>}
    {myRequests.length > 0 && (
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tipo</th><th>Estado</th><th>Paso actual</th><th>Fecha</th></tr></thead>
          <tbody>
            {myRequests.map((r) => (
              <tr>
                <td data-label="Tipo">{TYPE_LABELS[r.type] ?? r.type}</td>
                <td data-label="Estado">
                  <span class={`badge ${STATUS_BADGE[r.status] ?? 'badge-neutral'}`}>
                    {STATUS_LABELS[r.status] ?? r.status}
                  </span>
                </td>
                <td data-label="Paso actual">{r.currentStep}</td>
                <td data-label="Fecha">{new Date(r.createdAt).toLocaleDateString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>
